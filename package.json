{
  "name": "nhentai-pdf",
  "version": "1.0.0",
  "description": "Combine WEBP images into a PDF",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.nhentai.pdf",
    "productName": "transmute",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
